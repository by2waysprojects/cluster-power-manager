ARG BASE_IMAGE=scratch
ARG BUILDER_IMAGE=quay.io/projectquay/golang:1.26

# Build the node agent binary
FROM --platform=$BUILDPLATFORM ${BUILDER_IMAGE} AS builder
ARG TARGETOS \
    TARGETARCH

# Go toolchain settings, consumed directly by the go command. The defaults
# produce a static binary suitable for the default scratch BASE_IMAGE.
# Overriding CGO_ENABLED=1 yields a dynamically linked binary and requires a
# BASE_IMAGE that provides a dynamic loader and the needed shared libraries.
ARG CGO_ENABLED=0
ARG GOFLAGS
ARG GOEXPERIMENT
# Downstream builds using an OpenSSL-enabled Go toolchain can set GOFIPS140=off
# to disable Go's native FIPS mode and use the toolchain's OpenSSL backend.
# This requires CGO_ENABLED=1 and a BASE_IMAGE providing the appropriate
# FIPS-validated OpenSSL module, configured for FIPS operation at runtime.
ARG GOFIPS140

WORKDIR /workspace
# Copy the Go Modules manifests
COPY go.mod go.mod
COPY go.sum go.sum
# Bring in the go dependencies before anything else so we can take
# advantage of caching these layers in future builds.
COPY vendor/ vendor/
# Copy the go source
COPY build/nodeagent/main.go main.go
COPY api/ api/
COPY controllers/ controllers/
COPY pkg/ pkg/
COPY internal/ internal/

# Create non-root user
RUN mkdir -p /install_root/etc \
    && groupadd -g 1099 "cpm" \
    && useradd -g "cpm" -u 10001 -s /sbin/nologin power-node-agent \
    && tail -1 /etc/passwd > /install_root/etc/passwd

# Build
RUN GO111MODULE=on GOOS=${TARGETOS:-linux} GOARCH=$TARGETARCH go build -a -o /install_root/nodeagent ./main.go

FROM ${BASE_IMAGE}
WORKDIR /
COPY LICENSE /licenses/LICENSE
COPY --from=builder /install_root .
USER 10001

ENTRYPOINT ["/nodeagent"]
