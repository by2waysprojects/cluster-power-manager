ARG BASE_IMAGE=registry.fedoraproject.org/fedora-minimal:42
ARG BUILDER_IMAGE=quay.io/projectquay/golang:1.24
ARG STRICTFIPS="false"

# Build the node agent binary
FROM --platform=$BUILDPLATFORM ${BUILDER_IMAGE} AS builder
ARG TARGETOS \
    TARGETARCH \
    STRICTFIPS

WORKDIR /workspace
# Copy the Go Modules manifests
COPY go.mod go.mod
COPY go.sum go.sum
# Bring in the go dependencies before anything else so we can take
# advantage of caching these layers in future builds.
COPY vendor/ vendor/
# Copy the go source
COPY build/nodeagent/main.go main.go
COPY api/ api/
COPY controllers/ controllers/
COPY pkg/ pkg/
COPY internal/ internal/

# Create non-root user
RUN mkdir -p /install_root/etc \
    && groupadd -g 1099 "cpm" \
    && useradd -g "cpm" -u 10001 -s /sbin/nologin power-node-agent \
    && tail -1 /etc/passwd > /install_root/etc/passwd

# Build
# When STRICTFIPS is true, enable CGO and the strictfipsruntime build tag
# for FIPS-compliant builds required by downstream (e.g. Konflux/OCP).
RUN if [ "$STRICTFIPS" = "true" ]; then \
        CGO_ENABLED=1 GOOS=${TARGETOS:-linux} GOARCH=$TARGETARCH GO111MODULE=on \
        go build -tags strictfipsruntime -a -o /install_root/nodeagent ./main.go; \
    else \
        CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=$TARGETARCH GO111MODULE=on \
        go build -a -o /install_root/nodeagent ./main.go; \
    fi

FROM ${BASE_IMAGE}
WORKDIR /
COPY LICENSE /licenses/LICENSE
COPY --from=builder /install_root .
RUN microdnf install -y util-linux && microdnf clean all
USER 10001

ENTRYPOINT ["/nodeagent"]
